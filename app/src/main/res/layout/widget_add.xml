<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 1 × 1: jedno tlačidlo +, ktoré otvorí Novú transakciu (G9).
     RemoteViews nepoužíva AppCompat, preto android:tint (nie app:tint). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <ImageView
        android:id="@+id/widget_add_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_add_background"
        android:contentDescription="@string/nav_add"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_plus"
        android:tint="@color/gros_on_primary"
        tools:ignore="UseAppTint" />
</FrameLayout>
